#include <zephyr/dt-bindings/mipi_dbi/mipi_dbi.h>

/* Allow the sensor rail to be powered down when it is not in use. */
&sensor_enable {
	/delete-property/ regulator-boot-on;
	regulator-boot-off;
};

/ {
	aliases {
		led0 = &green_led;
	};

	chosen {
		zephyr,display = &display;
	};

	mipi_dbi {
		compatible = "zephyr,mipi-dbi-spi";
		spi-dev = <&eusart1>;
		dc-gpios = <&gpiob 0 GPIO_ACTIVE_HIGH>; /* EXP09 */
		reset-gpios = <&gpiod 2 GPIO_ACTIVE_LOW>; /* EXP13 */
		write-only;
		#address-cells = <1>;
		#size-cells = <0>;

		display: display@1 {
			compatible = "sitronix,st7796s";
			reg = <0x1>;
			mipi-max-frequency = <DT_FREQ_M(20)>;
			mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
			color-coding = "MIPI_DBI_MODE_RGB565";
			height = <320>;
			width = <480>;
			color-invert;
			madctl = <0x28>;
			pgc = [f0 06 0b 07 06 05 2e 33 47 3a 17 16 2e 31];
			ngc = [f0 09 0d 09 08 23 2e 33 46 38 13 13 2c 32];
		};
	};
};

&eusart1 {
	clock-frequency = <DT_FREQ_M(20)>;
	cs-gpios = <&gpioc 0 GPIO_ACTIVE_LOW>,
		   <&gpioa 7 GPIO_ACTIVE_LOW>;
	status = "okay";
};

&usart0 {
	current-speed = <115200>;
};
